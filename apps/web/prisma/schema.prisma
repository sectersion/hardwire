generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
  REVIEWER
  SUPERADMIN
}

enum Tier {
  T1
  T2
  T3
}

enum TierStatus {
  LOCKED
  ACTIVE
  COMPLETED
}

enum SubmissionType {
  DESIGN
  SIMULATION
  GDS
  PCB
}

enum SubStatus {
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum ShipStatus {
  PREPARING
  SHIPPED
  DELIVERED
}

// Actions this covers: perma-reject, undo-reject, ban, restore, soft
// delete, restore project. actorId is nullable so a log entry can
// survive even if the acting admin's User row is later deleted.
enum AuditAction {
  SUBMISSION_REJECTED
  SUBMISSION_REJECT_UNDONE
  USER_BANNED
  USER_RESTORED
  PROJECT_DELETED
  PROJECT_RESTORED
}

model AuditLog {
  id         String      @id @default(uuid())
  action     AuditAction
  actorId    String?
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetType String // "Submission" | "Project" | "User"
  targetId   String
  reason     String?
  createdAt  DateTime    @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  firstName       String
  lastName        String
  avatarUrl       String?
  birthday        DateTime?
  country         String?
  address         Json?
  discordHandle   String?
  githubId        String?
  hcaId           String    @unique
  slackUserId     String?
  roles           Role[]
  onboardComplete Boolean   @default(false)
  banned          Boolean   @default(false)
  bannedAt        DateTime?
  bannedBy        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions    UserSession[]
  projects    Project[]
  tiers       TierProgress[]
  submissions Submission[]
  shipments   Shipment[]
  auditLogs   AuditLog[]     @relation("AuditActor")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  repoUrl     String?
  currentTier Tier      @default(T1)
  // Set when a submission on this project is perma-rejected. Hidden
  // projects are excluded from the dashboard project list and can't
  // receive new submissions. Reversed only by undoReject (admin-gated).
  hidden      Boolean   @default(false)
  hiddenAt    DateTime?
  hiddenBy    String?
  // Soft delete — admin-gated. Excluded from all normal queries once
  // set; restore just clears it back to null.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tiers       TierProgress[]
  submissions Submission[]
  shipments   Shipment[]

  @@index([userId])
}

model TierProgress {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tier       Tier
  status     TierStatus @default(LOCKED)
  startedAt  DateTime?
  completedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([projectId, tier])
  @@index([userId])
}

model Submission {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tier          Tier
  type          SubmissionType
  title         String
  description   String?
  files         Json
  commitUrl     String?
  status        SubStatus      @default(PENDING_REVIEW)
  reviewerNotes String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  shipments Shipment[]

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

model Shipment {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tier         Tier
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  trackingUrl  String?
  carrier      String?
  status       ShipStatus @default(PREPARING)
  shippedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
  @@index([status])
}
