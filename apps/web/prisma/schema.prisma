generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  REVIEWER
  SUPERADMIN
}

enum Tier {
  T1
  T2
  T3
}

enum TierStatus {
  LOCKED
  ACTIVE
  COMPLETED
}

enum SubmissionType {
  DESIGN
  SIMULATION
  GDS
  PCB
}

enum SubStatus {
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

enum ShipStatus {
  PREPARING
  SHIPPED
  DELIVERED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  firstName       String
  lastName        String
  avatarUrl       String?
  birthday        DateTime?
  country         String?
  address         Json?
  discordHandle   String?
  githubId        String?
  hcaId           String    @unique
  slackUserId     String?
  roles           Role[]
  onboardComplete Boolean   @default(false)
  banned          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions    UserSession[]
  projects    Project[]
  tiers       TierProgress[]
  submissions Submission[]
  shipments   Shipment[]
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  repoUrl     String?
  currentTier Tier     @default(T1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tiers       TierProgress[]
  submissions Submission[]
  shipments   Shipment[]

  @@index([userId])
}

model TierProgress {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tier       Tier
  status     TierStatus @default(LOCKED)
  startedAt  DateTime?
  completedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([projectId, tier])
  @@index([userId])
}

model Submission {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tier          Tier
  type          SubmissionType
  title         String
  description   String?
  files         Json
  commitUrl     String?
  status        SubStatus      @default(PENDING_REVIEW)
  reviewerNotes String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  shipments Shipment[]

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

model Shipment {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tier         Tier
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  trackingUrl  String?
  carrier      String?
  status       ShipStatus @default(PREPARING)
  shippedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
  @@index([status])
}
